# Gateway settings (SPEC.md section 11). Copied to .env by *-start-prod.sh; never commit .env.
ENV=production
# URL path prefixes, used exactly as written: one path segment each (letters, digits, - or _), must differ.
# Anything outside them is a bare 404, so hard-to-guess values hide the gateway from scanners.
API_PREFIX=api
ADMIN_PREFIX=admin
# Hostnames clients put in the URL (the Host header), comma-separated; any names you like. Requests using another
# name get a bare 404. Not the caller's machine: callers can be anywhere.
# e.g. API_HOSTS=gw.example.com (Cloudflare Tunnel), ADMIN_HOSTS=mybox.tailnet-name.ts.net (tailscale serve)
API_HOSTS=localhost,127.0.0.1
ADMIN_HOSTS=localhost,127.0.0.1
# Peers whose CF-Connecting-IP / X-Forwarded-For are trusted (the Caddy container).
TRUSTED_PROXY_IPS=
TELEGRAM_POLL_TIMEOUT_S=30
UPSTREAM_TIMEOUT_S=15
UPSTREAM_MAX_BYTES=1048576
API_RATE_PER_MIN=120
SESSION_IDLE_MIN=60
AUDIT_RETENTION_DAYS=90
DEFAULT_MESSAGE_RETENTION_DAYS=30
# Dev only. Startup fails if this is set while ENV=production.
DEV_AUTO_UNLOCK_PASSPHRASE=
# Host port (127.0.0.1) for prod.
GATEWAY_PORT=38080
